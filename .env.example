# ── Required ────────────────────────────────────────────────────────────────

# Session signing secret (generate with: openssl rand -base64 32)
AUTH_SECRET=

# The URL users open; sign-in redirects go here. Use the server's IP or domain,
# e.g. http://192.0.2.10:3000, not localhost, unless only the server's own
# browser is used.
AUTH_URL=http://localhost:3000

# heretix-api's API key: the API_KEY in heretix-api's .env. Can also be set on
# the Settings page.
HERETIX_API_KEY=

# heretix-api's URL. The default already reaches a heretix-api on the same host:
# http://host.docker.internal:5000 with Docker Compose, http://localhost:5000
# without. Set it only for a heretix-api elsewhere. Can also be set on the
# Settings page.
# HERETIX_API_URL="http://192.0.2.20:5000"

# ── Docker Compose ──────────────────────────────────────────────────────────

# Password of the bundled database. Change it: changeme is for a local trial.
POSTGRES_PASSWORD=changeme

# ── Without Docker ──────────────────────────────────────────────────────────
# Ignored by Docker Compose, which connects the app to its own database.

DATABASE_URL="postgresql://user:password@localhost:5432/heretix_management"

# Disposable database for `pnpm test:integration`. Never point this at the
# dev database: every test run truncates all tables.
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/heretix_management_test"

# ── Optional ────────────────────────────────────────────────────────────────

# Scheduled jobs (cron syntax, UTC): refresh at 12:00, then scan at 13:00
CRON_REFRESH="0 12 * * *"
CRON_SCAN="0 13 * * *"
